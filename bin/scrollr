#!/bin/zsh
set -e

project_dir="$(cd "$(dirname "$0")/.." && pwd)"
cd "$project_dir" || exit 1
source .venv/bin/activate

lan_ip=""
for interface in en0 en1; do
  lan_ip="$(/usr/sbin/ipconfig getifaddr "$interface" 2>/dev/null || true)"
  [[ -n "$lan_ip" ]] && break
done
if [[ -z "$lan_ip" ]]; then
  lan_ip="$(.venv/bin/python -c '
import socket

try:
    with socket.socket(socket.AF_INET, socket.SOCK_DGRAM) as probe:
        probe.connect(("192.0.2.1", 80))
        print(probe.getsockname()[0])
except OSError:
    print("")
')"
fi

start_port="${PORT:-8080}"
port="$(.venv/bin/python -c '
import socket
import sys

for port in range(int(sys.argv[1]), 65536):
    with socket.socket() as server:
        try:
            server.bind(("0.0.0.0", port))
        except OSError:
            continue
        print(port)
        break
else:
    raise SystemExit("No available port found")
' "$start_port")"

env DJANGO_DEBUG=true python manage.py sync_library

allowed_hosts="${ALLOWED_HOSTS:-localhost,127.0.0.1}"
if [[ -n "$lan_ip" ]]; then
  allowed_hosts="$allowed_hosts,$lan_ip"
  echo "Starting Scrollr at http://127.0.0.1:$port and http://$lan_ip:$port"
else
  echo "Starting Scrollr at http://127.0.0.1:$port"
  echo "Could not determine a LAN IP address."
fi
(sleep 1 && open "http://127.0.0.1:$port") >/dev/null 2>&1 &
exec env DJANGO_DEBUG=true ALLOWED_HOSTS="$allowed_hosts" python -m gunicorn \
  scrollr.wsgi:application --workers 1 --bind "0.0.0.0:$port"
