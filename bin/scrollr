#!/bin/zsh
set -e

cd "$(dirname "$0")/.."
.venv/bin/python manage.py migrate --noinput
.venv/bin/python manage.py sync_library

lan_ip="$(/usr/sbin/ipconfig getifaddr en0 2>/dev/null || /usr/sbin/ipconfig getifaddr en1 2>/dev/null || true)"
allowed_hosts="localhost,127.0.0.1${lan_ip:+,$lan_ip}"
if [[ -n "$lan_ip" ]]; then
  echo "Open Scrollr on this network at http://$lan_ip:8000"
else
  echo "Could not detect the Mac's LAN IP; Scrollr is still available at http://127.0.0.1:8000"
fi

(sleep 1 && open http://127.0.0.1:8000) >/dev/null 2>&1 &
exec env ALLOWED_HOSTS="$allowed_hosts" .venv/bin/python manage.py runserver 0.0.0.0:8000
