# Python environment and cache
.venv/
__pycache__/
*.py[cod]

# Local database and collected static files
*.sqlite3
/var/static/*

# Keep the baseline schema migration; ignore newly generated migrations.
/scrollr/migrations/*.py
!/scrollr/migrations/__init__.py
!/scrollr/migrations/0001_initial.py

# Keep the included library visible to Git; ignore additional local media files.
/data/*
!/data/.gitkeep
